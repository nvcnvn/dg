# Text files are checked out with LF on every platform: the goldens and generated files are
# compared byte for byte.
* text=auto eol=lf
# Keeps CRLF line endings, which the language server test of it covers.
testdata/lsp/unicode/model.hcl -text
# Keeps CRLF line endings, which the dg pack edit of dg.hcl is tested on.
testdata/ops/pack/crlf/* -text
