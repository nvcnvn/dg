{
  "name": "dg-diagrams",
  "displayName": "dg Diagrams",
  "description": "Diagrams as code: write HCL, arrange by dragging, and let arrows route themselves. Built for reviews and coding agents.",
  "version": "0.0.1",
  "publisher": "nvcnvn",
  "license": "Apache-2.0",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1E3A8A",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nvcnvn/dg",
    "directory": "vscode"
  },
  "homepage": "https://nvcnvn.github.io/dg/",
  "bugs": {
    "url": "https://github.com/nvcnvn/dg/issues"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "diagram",
    "diagram-as-code",
    "hcl",
    "architecture",
    "c4",
    "flowchart",
    "er-diagram",
    "state-machine",
    "mcp",
    "ai-agents"
  ],
  "activationEvents": [
    "workspaceContains:**/dg.hcl",
    "onStartupFinished"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "dg",
        "aliases": [
          "dg"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dg",
        "scopeName": "source.dg",
        "path": "./syntaxes/hcl.tmGrammar.json"
      }
    ],
    "configuration": {
      "title": "dg",
      "properties": {
        "dg.projectFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "Folders that are dg projects although they hold no `dg.hcl`, relative to the workspace folder. A `.hcl` file in a dg project that opens as plain text or HCL gets the language dg and dg's language server."
        }
      }
    },
    "commands": [
      {
        "command": "dg.openDiagram",
        "title": "Open diagram",
        "category": "dg",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "dg.openDiagram",
          "when": "editorLangId == dg",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "dg.openDiagram",
          "when": "resourceLangId == dg",
          "group": "1_open"
        }
      ],
      "explorer/context": [
        {
          "command": "dg.openDiagram",
          "when": "resourceFilename == dg.hcl",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "tsc -p . && node out/test/run.js"
  },
  "dependencies": {
    "vscode-languageclient": "11.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.91.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "ovsx": "1.3.0",
    "typescript": "7.0.2"
  }
}
