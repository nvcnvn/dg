{
  "name": "dg",
  "displayName": "dg",
  "description": "Language server and diagram panel for dg projects.",
  "version": "0.0.1",
  "publisher": "nvcnvn",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nvcnvn/dg"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "activationEvents": [
    "workspaceContains:**/dg.hcl",
    "onStartupFinished"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "dg",
        "aliases": [
          "dg"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dg",
        "scopeName": "source.dg",
        "path": "./syntaxes/hcl.tmGrammar.json"
      }
    ],
    "configuration": {
      "title": "dg",
      "properties": {
        "dg.projectFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "Folders that are dg projects although they hold no `dg.hcl`, relative to the workspace folder. A `.hcl` file in a dg project that opens as plain text or HCL gets the language dg and dg's language server."
        }
      }
    },
    "commands": [
      {
        "command": "dg.openDiagram",
        "title": "Open diagram",
        "category": "dg"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "tsc -p . && node out/test/run.js"
  },
  "dependencies": {
    "vscode-languageclient": "11.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.91.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "typescript": "7.0.2"
  }
}
